PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hosted SQLite. On Vercel use a libsql:// URL and TURSO_AUTH_TOKEN.
# Local development can use a file URL and leave the token empty.
TURSO_DATABASE_URL=file:data/waitlist.db
TURSO_AUTH_TOKEN=

# Only used by scripts/migrate-from-mongo.js. Remove after the copy.
DATABASE_URI=
